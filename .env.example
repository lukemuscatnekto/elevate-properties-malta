# ---- Site settings ----
# Production site origin (embedded at build — update if domain changes).
VITE_SITE_URL="https://elevateproperties.com"

# ---- Forms (Formspree) ----
# VITE_* values are inlined at build time — change .env.local then restart dev server or rebuild for production.
#
# 1. Create a form at https://formspree.io and copy the POST URL (https://formspree.io/f/xxxxxxxx).
# 2. Set both variables below. Replace the endpoint placeholder with your real URL before shipping.
#
VITE_FORM_PROVIDER=formspree
VITE_FORMSPREE_ENDPOINT=

# Example after you paste your endpoint:
# VITE_FORM_PROVIDER=formspree
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Local browser-only demo (no outbound email) — uncomment for offline UI work only:
# VITE_FORM_PROVIDER=none
# VITE_FORMSPREE_ENDPOINT=

# JSON payloads always include: formType, subject, website, submittedAt, name, email, phone, message,
# pageUrl, and (when present) referrer. Viewing adds propertyTitle, propertyId, propertyPrice, propertyLocation.

# EmailJS (not implemented in submitForm unless you extend it):
# VITE_EMAILJS_SERVICE_ID=""
# VITE_EMAILJS_TEMPLATE_ID=""
# VITE_EMAILJS_PUBLIC_KEY=""
