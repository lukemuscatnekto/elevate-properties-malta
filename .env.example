# ---- Site settings ----
# TODO: Replace with your real production URL before launch.
VITE_SITE_URL="https://elevate-properties-malta.example.com"

# ---- Form provider switch ----
# one of: none | formspree | netlify | emailjs
VITE_FORM_PROVIDER="none"

# Formspree: create ONE form endpoint; JSON payloads differentiate intent via field `formType`:
# - `contact`  → enquire form (#contact)
# - `valuation` → list / valuation brief (#list-property)
# - `viewing`  → property modal "Request private viewing"
# Optionally create separate Formspree forms and branch in code later — unnecessary for MVP.
VITE_FORMSPREE_ENDPOINT=""

# EmailJS (if chosen):
# VITE_EMAILJS_SERVICE_ID=""
# VITE_EMAILJS_TEMPLATE_ID=""
# VITE_EMAILJS_PUBLIC_KEY=""
