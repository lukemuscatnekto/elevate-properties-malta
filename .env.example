# ---- Site settings ----
# Production site origin (embedded at build, update if the domain changes).
VITE_SITE_URL="https://elevatepropertiesmalta.com"

# ---- Forms (Contact, List Property, Request Viewing) ----
#
# Two variables control whether the public forms deliver real emails.
#
#   VITE_FORM_PROVIDER:
#     none      = local browser demo mode. Submissions resolve in-browser only,
#                 no email is sent. Use this for offline UI work and reviews.
#     formspree = production. Submissions POST to your Formspree endpoint.
#                 This is what production deployments (Netlify, Vercel) should use.
#
#   VITE_FORMSPREE_ENDPOINT:
#     Required when VITE_FORM_PROVIDER=formspree.
#     Must be your real https://formspree.io/f/<form-id> URL.
#     Placeholder values like YOUR_FORM, PASTE_FORMSPREE, or xxxxxxxx are rejected
#     by the client; the form then shows the phone/WhatsApp/email fallback message.
#
# VITE_* values are inlined at build time. After editing locally, restart `npm run dev`.
# After changing host env vars in Netlify/Vercel, trigger a fresh deploy.

VITE_FORM_PROVIDER=none
VITE_FORMSPREE_ENDPOINT=

# Example production values (set these in the host dashboard, never commit secrets):
# VITE_FORM_PROVIDER=formspree
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Each submission POST includes: formType, subject, website, submittedAt, name, email, phone,
# message, pageUrl, and (when present) referrer. The viewing flow also includes propertyTitle,
# propertyId, propertyPrice, propertyLocation. Honeypot field `_gotcha` is stripped before send.

# EmailJS placeholder (not wired in submitForm unless you extend it):
# VITE_EMAILJS_SERVICE_ID=""
# VITE_EMAILJS_TEMPLATE_ID=""
# VITE_EMAILJS_PUBLIC_KEY=""
